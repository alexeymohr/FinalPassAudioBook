{
  "model_type": "speech_truncation_detection",
  "architectures": [
    "SpeechTruncationDetectionModel"
  ],
  "auto_map": {
    "AutoConfig": "configuration_speech_truncation_detection.SpeechTruncationDetectionConfig",
    "AutoModel": "modeling_speech_truncation_detection.SpeechTruncationDetectionModel"
  },
  "model_config": {
    "num_labels": 2,
    "classifier_dropout": 0.1,
    "input_projection_bias": true,
    "label_smoothing": 0.02,
    "disable_causal_attention": false,
    "attn_implementation": "flash_attention_2",
    "llama_config": {
      "vocab_size": 32,
      "pad_token_id": 0,
      "bos_token_id": 1,
      "eos_token_id": 2,
      "hidden_size": 384,
      "intermediate_size": 888,
      "num_hidden_layers": 8,
      "num_attention_heads": 8,
      "num_key_value_heads": 8,
      "max_position_embeddings": 2048,
      "rms_norm_eps": 1e-06,
      "rope_theta": 10000.0,
      "attention_dropout": 0.0,
      "attention_bias": false,
      "mlp_bias": false
    }
  },
  "audio_config": {
    "target_sample_rate": 16000,
    "n_fft": 400,
    "win_length": 400,
    "hop_length": 160,
    "n_mels": 80,
    "f_min": 0.0,
    "f_max": null,
    "mel_power": 2.0,
    "window_fn": "hamming",
    "center": false,
    "pad_mode": "constant",
    "mel_log_eps": 1e-06,
    "use_styletts_mel_normalization": true
  },
  "label_ignore_index": -100,
  "inference": {
    "tail_seconds": 5.0,
    "decision_window_ms": 30.0,
    "threshold": 0.5,
    "policy": "tail_max_prob_threshold"
  }
}
